# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database
PINECONE_HOST=https://your-index.svc.region.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_index_name

# Supabase PostgreSQL Database
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_PROJECT_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Redis Cache (AWS ElastiCache)
REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=true
REDIS_CACHE_ENABLED=true

# Admin Dashboard Credentials
ADMIN_USERNAME=Hazard
ADMIN_PASSWORD=Hazard

# Django Secret Key (IMPORTANT: Generate a new random key for production!)
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django

# Debug Mode
DEBUG=False
